{
  "name": "automation-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Remote Phone Automation - desktop wrapper",
  "main": "main.js",
  "scripts": {
    "build:server": "node scripts/build.mjs",
    "start": "electron .",
    "dev": "electron . --dev",
    "dist": "npm run build:server && electron-builder --win",
    "dist:portable": "npm run build:server && electron-builder --win portable",
    "dist:dir": "npm run build:server && electron-builder --win dir"
  },
  "build": {
    "appId": "com.automation.desktop",
    "productName": "Automation Desktop",
    "copyright": "Copyright © 2026",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "dist/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "dist/server",
        "to": "server"
      }
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Automation Desktop",
      "artifactName": "Automation-Desktop-${version}-Setup.${ext}"
    },
    "portable": {
      "artifactName": "Automation-Desktop-${version}-Portable.${ext}"
    },
    "electronUpdaterCompatibility": ">=2.16",
    "publish": null
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^26.15.3",
    "electron-updater": "^6.8.9"
  }
}
